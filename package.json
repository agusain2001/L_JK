{
  "name": "for-you-a-little-sky",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:prepare:postgres": "node scripts/prepare-postgres.mjs",
    "db:generate:postgres": "prisma generate --schema prisma/postgresql/schema.prisma",
    "db:setup:postgres": "prisma migrate deploy --schema prisma/postgresql/schema.prisma",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "db:setup": "node scripts/setup-db.mjs",
    "test": "tsx --test tests/unit.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1148.0",
    "@phosphor-icons/react": "^2.1.10",
    "@prisma/client": "6.19.0",
    "@react-three/drei": "^10.7.0",
    "@react-three/fiber": "^9.4.0",
    "apify-client": "^2.19.0",
    "better-auth": "^1.7.7",
    "gsap": "^3.13.0",
    "leaflet": "^1.9.4",
    "lenis": "^1.3.0",
    "motion": "^12.23.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "three": "^0.180.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.180.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "prisma": "6.19.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
