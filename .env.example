DATABASE_URL="file:./dev.db"
# Set a long random password (at least 24 characters). Admin is disabled without it.
ADMIN_SECRET=
APIFY_API_TOKEN=
APIFY_DATASET_ID=
# Optional: run a preconfigured task using its saved input.
APIFY_TASK_ID=
# Optional: actor execution requires an inspected schema and verified input file.
APIFY_ACTOR_ID=
APIFY_ACTOR_INPUT_FILE=
APIFY_ACTOR_SCHEMA_VERIFIED=false
APIFY_WEBHOOK_SECRET=

# Local development creates a persistent secret in .data; production supplies one.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL="http://127.0.0.1:3000"
DATABASE_PROVIDER="sqlite"

# Private storage for Little World attachments. Empty = local .data/world-media.
S3_BUCKET=
S3_REGION="us-east-1"
S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
